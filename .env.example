# =============================================================================
# MARGINALIA ACADEMIC COMPANION - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual API keys

# -----------------------------------------------------------------------------
# REQUIRED: Gemini AI API Key (for AI Research Assistant)
# -----------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/
# The AI assistant provides literature synthesis, summarization, and research guidance
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# REQUIRED: Firebase Configuration (for user accounts & cross-device sync)
# -----------------------------------------------------------------------------
# Create a Firebase project at: https://console.firebase.google.com/
# Enable Authentication (Google + Email/Password) and Firestore Database
# Then add your project credentials here:
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# -----------------------------------------------------------------------------
# OPTIONAL: App Configuration
# -----------------------------------------------------------------------------
# The base URL where this app is hosted (for OAuth callbacks)
# Default: http://localhost:3000 (development)
APP_URL=http://localhost:3000

# Port for the development server (optional, default: 3000)
PORT=3000
