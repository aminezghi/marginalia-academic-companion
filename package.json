{
  "name": "marginalia-academic-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx dev-server.ts",
    "dev:local": "firebase emulators:exec --project marginalia-test-emulator --only auth,firestore,storage \"npm run dev\"",
    "build": "vite build",
    "start": "tsx dev-server.ts",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "emulators:test": "firebase emulators:start --project marginalia-test-emulator --only auth,firestore,storage",
    "lint": "tsc --noEmit",
    "install:firebase": "npm install firebase",
    "install:firebase-types": "npm install -D @types/firebase",
    "test:security": "firebase emulators:exec --project marginalia-test-emulator --only auth,firestore,storage --config firebase.security-test.json \"jest tests/security/ --no-coverage\"",
    "test": "jest --no-coverage",
    "test:e2e": "firebase emulators:exec --project marginalia-test-emulator --only auth,firestore,storage --config firebase.e2e.json \"playwright test\"",
    "test:e2e:debug": "firebase emulators:exec --project marginalia-test-emulator --only auth,firestore,storage --config firebase.e2e.json \"playwright test --debug\"",
    "test:e2e:headed": "firebase emulators:exec --project marginalia-test-emulator --only auth,firestore,storage --config firebase.e2e.json \"playwright test --headed\"",
    "desktop:windows": "npm --prefix desktop run build:windows"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-pdf": "^11.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.34.2",
    "glob": "^14.0.3",
    "jest": "^29.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "uuid": "^14.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "[/\\\\]\\._"
    ],
    "transform": {},
    "verbose": true,
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
