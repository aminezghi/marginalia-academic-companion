rules_version = '2';
service cloud.storage {
  match /b/{bucket}/o {
    
    // =========================================================================
    // USER PDFS
    // Path: pdfs/{uid}/{timestamp}_{uuid}_{originalName}.pdf
    // Storage path format: timestamp (13 digits)_uuid (8 hex chars)_originalName.pdf
    // Example: 1700000000000_abc12345_paper-title.pdf
    // =========================================================================
    match /pdfs/{uid}/{fileName} {
      // READ: Only authenticated owner can read
      allow read: if request.auth != null 
                    && request.auth.uid == uid
                    && isValidFilename(fileName)
                    && isValidPdfExtension(fileName);
      
      // WRITE: Only authenticated owner can write valid PDFs
      allow write: if request.auth != null 
                   && request.auth.uid == uid
                   && request.resource.contentType == 'application/pdf'
                   && request.resource.size > 0
                   && request.resource.size <= 100 * 1024 * 1024  // 100MB max
                   && isValidFilename(fileName)
                   && isValidPdfExtension(fileName);
      
      // Helper function: validate filename pattern (timestamp_uuid_name.pdf)
      function isValidFilename(name) {
        // Must match: 13 digit timestamp + underscore + 8 hex UUID + underscore + safe name + .pdf
        return name.matches('^\\d{13}_[a-fA-F0-9]{8}_[a-zA-Z0-9_-]+\\.pdf$');
      }
      
      // Helper function: ensure extension is .pdf
      function isValidPdfExtension(name) {
        return name.matches('.*\\.pdf$');
      }
    }
    
    // =========================================================================
    // USER AVATARS (future use)
    // Path: avatars/{userId}.png
    // =========================================================================
    match /avatars/{userId}.png {
      allow read: if true;  // Public read for profile display
      
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.contentType == 'image/png'
                   && request.resource.size > 0
                   && request.resource.size <= 2 * 1024 * 1024;  // 2MB max
    }
    
    // =========================================================================
    // VOLUME COVERS (future use)
    // Path: covers/{userId}/{volumeId}.jpg
    // =========================================================================
    match /covers/{userId}/{volumeId}.jpg {
      allow read: if true;  // Public read
      
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.contentType == 'image/jpeg'
                   && request.resource.size > 0
                   && request.resource.size <= 5 * 1024 * 1024;  // 5MB max
    }
    
    // =========================================================================
    // DENY ALL OTHER PATHS - DEFAULT DENY
    // =========================================================================
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
